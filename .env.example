# Environment Configuration for Grey River Lodge
# 
# SECURITY WARNING: Never commit real secrets or API keys to version control.
# Use Netlify Environment Variables panel to configure these in production.
# 
# Netlify will automatically inject these at build and runtime.

# Gemini AI API Key - Required for AI chat concierge feature
# Get your key from: https://makersuite.google.com/app/apikey
# This should ONLY be set in Netlify Environment Variables, never in .env files
GEMINI_API_KEY=your_gemini_api_key_here

# Application URL - Set automatically by Netlify at runtime
# Used for self-referential links, OAuth callbacks, and API endpoints
APP_URL=https://your-netlify-domain.netlify.app

